{
  "mcpServers": {
    "unity-anklebreaker": {
      "command": "node",
      "args": ["mcp-servers/unity/AnkleBreaker.unity-mcp-server/src/index.js"]
    },
    "unity-coplay": {
      "disabled": true,
      "command": "uvx",
      "args": ["--from", "mcpforunityserver", "mcp-for-unity", "--transport", "stdio"]
    },
    "unity-codergamester": {
      "disabled": true,
      "command": "node",
      "args": ["mcp-servers/unity/CoderGamester.mcp-unity/Server~/build/index.js"]
    },
    "unity-jackwrichards": {
      "disabled": true,
      "command": "node",
      "args": ["mcp-servers/unity/jackwrichards.UnityMCP/unity-mcp-server/build/index.js"]
    },
    "unreal-chir24": {
      "disabled": true,
      "command": "node",
      "args": ["mcp-servers/unreal/ChiR24.Unreal_mcp/dist/cli.js"]
    },
    "unreal-chongdashu": {
      "disabled": true,
      "command": "uv",
      "args": ["--directory", "mcp-servers/unreal/chongdashu.unreal-mcp/Python", "run", "unreal_mcp_server.py"]
    },
    "unreal-genorca": {
      "disabled": true,
      "command": "uv",
      "args": ["--directory", "mcp-servers/unreal/GenOrca.unreal-mcp/mcp-server", "run", "src/unreal_mcp/main.py"]
    },
    "unreal-kvick": {
      "disabled": true,
      "command": "python",
      "args": ["mcp-servers/unreal/kvick-games.UnrealMCP/MCP/unreal_mcp_bridge.py"]
    },
    "unreal-runreal": {
      "disabled": true,
      "command": "npx",
      "args": ["-y", "@runreal/unreal-mcp"]
    }
  }
}
